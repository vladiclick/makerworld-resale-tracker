# --- scraping ---
# Scraping is on-demand only, triggered from the dashboard's "Scrape now"
# control (or `npm run scrape` for a manual full-crawl backfill from the
# CLI). There is no scheduler/cron any more — the app targets Netlify
# Functions, which are stateless between invocations, so nothing keeps a
# background job alive.
#
# The scraper itself is plain `fetch` against MakerWorld's own JSON API, no
# headless browser involved. Playwright is a devDependency only, used by the
# one-off recon scripts below; run `npx playwright install chromium` once
# locally before using those (it is NOT installed automatically on
# `npm install`, and must never run on Netlify's build).
#   - scripts/inspect-dom.ts
#   - scripts/probe-api.ts
#   - scripts/probe-categories.ts

# polite delay between API calls, milliseconds
SCRAPE_DELAY_MIN_MS=2000
SCRAPE_DELAY_MAX_MS=3000
# re-running inside this window serves from cache instead of re-hitting MakerWorld (1h)
SCRAPE_CACHE_TTL_MS=3600000
# models fetched per target listing during a CLI full-crawl (`npm run scrape`), multiple of 20
SCRAPE_MAX_PER_TARGET=60

# --- retention ---
# raw snapshots older than this collapse into one row per model per day
RETENTION_RAW_DAYS=90

# --- scoring weights (must be > 0; they are normalised) ---
SCORE_W_GROWTH=0.35
SCORE_W_ENGAGEMENT=0.25
SCORE_W_TRACTION=0.10
SCORE_W_CATEGORY=0.20
SCORE_W_QUICKPRINT=0.10
# saturation reference points, calibrated against live MakerWorld data
SCORE_GROWTH_REF=150
SCORE_ENGAGEMENT_REF=4
SCORE_TRACTION_REF=5000
# shrinkage constant for the engagement ratio: likes/(downloads + K). Stops
# a 2-download/14-like model (ratio 7.0, pure noise) outranking a
# 510-download model. Raise it to be harsher on low-volume models.
SCORE_ENGAGEMENT_SMOOTH=25

# --- storage (Supabase / Postgres) ---
# Find both in the Supabase dashboard -> Project Settings -> API.
# SUPABASE_URL is the "Project URL".
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key. It bypasses
# Row Level Security entirely — server-only, never commit it, never send it
# to the browser. All client access to the data goes through this app's own
# API routes (src/app/api/**), not directly from the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- schema application (optional, local only) ---
# Direct Postgres connection, used by `npm run db:apply` to run supabase/schema.sql.
# Supabase dashboard -> Connect -> Direct/Connection string -> Session pooler
# (session pooler is IPv4; the "direct connection" option is IPv6-only).
# Contains your database password - never commit this.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
